# Create a copy of this file named ".env" in the same directory and fill in values.

# Supabase (required for auth/leaderboard; app runs without if omitted)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Mission Control (optional). The game runs without this.
# The service prefers VITE_OPENAI_API_KEY; in CRA use the fallback below or set both.
VITE_OPENAI_API_KEY=
REACT_APP_VITE_OPENAI_API_KEY=
