# Frontend environment variables (do not commit a real .env with secrets)
# Supabase (required for auth/leaderboard)
REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_KEY=your_supabase_anon_key

# Mission Control (OpenAI)
# Preferred for Vite-style env; the service also supports CRA fallback below.
VITE_OPENAI_API_KEY=your_openai_api_key
REACT_APP_VITE_OPENAI_API_KEY=your_openai_api_key
